{
  "expo": {
    "name": "SplitMate",
    "slug": "roomsplit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon1.png",
    "splash": {
      "backgroundColor": "#1AAD7D"
    },
    "android": {
      "package": "com.ankush.splitmate",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon1.png",
        "backgroundColor": "#1AAD7D"
      }
    },
    "ios": {
      "bundleIdentifier": "com.ankush.splitmate"
    },
    "extra": {
      "eas": {
        "projectId": "e282bb10-23ad-49c8-974e-c8a0d2241ceb"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SplitMate to access your camera to scan QR codes.",
          "microphonePermission": false
        }
      ]
    ]
  }
}