{
  "expo": {
    "name": "SplitMate",
    "slug": "roomsplit",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "platforms": ["android", "ios"],
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.ankush.splitmate",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1AAD7D"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.ankush.splitmate"
    },
    "extra": {
      "eas": {
        "projectId": "e282bb10-23ad-49c8-974e-c8a0d2241ceb"
      }
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow SplitMate to access your camera to scan QR codes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#1AAD7D",
          "resizeMode": "contain",
          "imageWidth": 200
        }
      ],
      "expo-font"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e282bb10-23ad-49c8-974e-c8a0d2241ceb"
    }
  }
}
