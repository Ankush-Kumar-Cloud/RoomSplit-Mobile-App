PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/roomsplit?retryWrites=true&w=majority

# ── Authentication ──────────────────────────────────────────────────────────
# CRITICAL: Use long, random strings. Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_access_token_secret_at_least_64_chars_long
REFRESH_TOKEN_SECRET=your_refresh_token_secret_different_from_jwt_secret
JWT_EXPIRES_IN=15m
